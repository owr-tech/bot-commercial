# ---- IA ----
AI_PROVIDER=mistral        # mistral | claude | openai | fallback
MISTRAL_API_KEY=xxx
MISTRAL_MODEL=ministral-8b-latest   # -latest moins sujet au rate-limit gratuit
ANTHROPIC_API_KEY=xxx
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=xxx
OPENAI_MODEL=gpt-4o-mini

# ---- WhatsApp Cloud API ----
WHATSAPP_TOKEN=xxx                 # token SYSTEM (permanent) recommandé en prod
WHATSAPP_PHONE_ID=xxx              # Phone number ID (alias accepté : PHONE_NUMBER_ID)
WABA_ID=xxx                        # WhatsApp Business Account ID
WA_FLOW_NAME=popaix_dates          # nom du Flow (calendrier + chambres)
WA_FLOW_ID=                        # optionnel : forcer un Flow existant
WHATSAPP_REDIRECT_NUMBER=2250702391982   # wa.me (retour depuis la page de paiement)
VERIFY_TOKEN=popaix2026

# ---- Telegram ----
TELEGRAM_TOKEN=xxx
TELEGRAM_BOT_USERNAME=popaixbot    # t.me/<username>
# Webhook (prod/serverless). En local on garde le polling.
TELEGRAM_WEBHOOK_SECRET=xxx        # optionnel : secret partagé avec Telegram
ADMIN_SECRET=xxx                   # requis pour GET /admin/set-telegram-webhook

# ---- Base de données ----
# Test local :
DATABASE_URL=sqlite:///./popaix.db
# Prod Neon / Postgres :
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ---- Bot / réservation ----
PUBLIC_BASE_URL=https://<service>.up.railway.app   # base des liens /booking/<id>
BOOKING_MAX_MONTHS=12              # horizon de réservation (mois)

# ---- Paiement PayDunya (agrégateur Wave / Orange Money / MTN / espèces) ----
PAYMENT_PROVIDER=paydunya   # none | paydunya
PAYDUNYA_ENV=test           # test (sandbox) | live
PAYDUNYA_MASTER_KEY=xxx     # clé TEST ou LIVE selon PAYDUNYA_ENV
PAYDUNYA_PRIVATE_KEY=xxx
PAYDUNYA_TOKEN=xxx          # os.getenv("PAYDUNYA_TOKEN")
PAYDUNYA_TOKEN_TYPE=invoice_token
PAYDUNYA_STORE_NAME=HOTEL POPAIX
PAYDUNYA_CALLBACK_URL=https://<service>.up.railway.app/webhook/paydunya
# La page de retour est générée par facture : PUBLIC_BASE_URL/booking/<id>
PAYDUNYA_RETURN_URL=https://<service>.up.railway.app
# Jeu de clés séparées test / live (optionnel) :
PAYDUNYA_TEST_MASTER_KEY=xxx
PAYDUNYA_TEST_TOKEN=xxx
PAYDUNYA_LIVE_MASTER_KEY=xxx
PAYDUNYA_LIVE_TOKEN=xxx